[node name="VersionText" type="RichTextLabel" parent="VersionNotes/VersionMargins/VersionNotesContent/VersionScroll" unique_id=1415664694]
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
text = "Version 0.1
-Added player movement
-Added enemies
-Added moving platforms
-Added death and respawning
-Added death sound
-Added main menu

Main Menu
-Added a new title screen that appears when the game is launched.
-Added a Start Game btton that loads the main gameplay scene.
-Added a Version Notes button for viewing development team and contributors.
-Added a Credits button for viewing the development team and contributors.
-Improved the organization of the menu using containers.
-Created the menu so that placeholders visuals can be replaced with final artwork

Version Notes
-Added a dedicated Version Notes screen.
-Added a scrollable area so older development updates can remain available as the project grows.
-Version notes now display the newest updates first.
-Added a Back button for returning to menu.
-Organized the version notes so future features, fixes, and changes can be added.

Credits
-Added a credits screen.
-Added Vertically scrolling movie-style credits.
-Added support for longer credit lists as more people contribute.
-Added a fixed Back button that remains available.
-The credits can be expanded later with roles, artwork, and other information"
fit_content = true

